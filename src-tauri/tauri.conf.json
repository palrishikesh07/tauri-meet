{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Meet Capture",
  "version": "0.1.0",
  "identifier": "com.taurimeet.recorder",
  "build": {
    "beforeDevCommand": "npm run dev:all",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:all",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AI I",
        "width": 850,
        "height": 600,
        "minWidth": 500,
        "minHeight": 300,
        "decorations": true,
        "transparent": true,
        "alwaysOnTop": false,
        "contentProtected": true,
        "resizable": true,
        "maximizable": true,
        "minimizable": true,
        "closable": true,
        "shadow": true,
        "skipTaskbar": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "../engine/meetrec"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}