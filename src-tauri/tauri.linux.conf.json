{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Meet Capture",
  "version": "0.1.0",
  "identifier": "com.taurimeet.recorder",

  "build": {
    "beforeDevCommand": "npm run dev:all",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:all",
    "frontendDist": "../dist"
  },

  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Meet Capture",
        "width": 480,
        "height": 840,
        "resizable": true,
        "center": true,
        "contentProtected": true
      }
    ],

    "security": {
      "csp": null
    }
  },

  "bundle": {
    "active": true,
    "targets": "all",

    "resources": [
      "../engine/meetrec"
    ],

    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}